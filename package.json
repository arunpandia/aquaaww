{
  "name": "aquaaww",
  "version": "1.1.4",
  "description": "A tiny menu-bar buddy that reminds you to drink water",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.aquaaww.app",
    "productName": "AquaAww",
    "afterPack": "./adhoc-sign.js",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "assets/presets/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/*.png",
      "assets/presets/*.mp4",
      "package.json",
      "!mobile/**",
      "!dist/**"
    ],
    "mac": {
      "identity": null,
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "resedit": "^3.1.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "license": "MIT",
  "author": "Harish",
  "repository": {
    "type": "git",
    "url": "https://github.com/arunpandia/aquaaww.git"
  },
  "homepage": "https://github.com/arunpandia/aquaaww#readme",
  "bugs": {
    "url": "https://github.com/arunpandia/aquaaww/issues"
  }
}
